PORT=5000
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# 32+ random chars, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRE=1d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CALLBACK_URL=

# Comma-separated frontend origins allowed by CORS (and for payment callback URLs)
CORS_ORIGINS=https://your-frontend.example.com
